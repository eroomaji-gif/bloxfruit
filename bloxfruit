-- ⚡ ระบบเทเลพอร์ตผลไม้มาหาตัวทันทีในเสี้ยววิ (กันคนตัดหน้า)
-- ==========================================
local function createInstantPullFruitToggle(targetPage)
    SettingsData.PullFruit = SettingsData.PullFruit or false
    local toggled = SettingsData.PullFruit
    local pullConnection = nil

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = toggled and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "⚡ เทเลพอร์ตผลไม้เข้าตัวทันที [ " .. (toggled and "ON" or "OFF") .. " ]"
    btn.TextColor3 = toggled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function runInstantPullTask(state)
        if state then
            pullConnection = task.spawn(function()
                local workspace = game:GetService("Workspace")
                local replicatedStorage = game:GetService("ReplicatedStorage")
                
                while toggled do
                    task.wait(0.1) -- เช็คไวแบบเรียลไทม์
                    
                    pcall(function()
                        local character = localPlayer.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local hrp = character.HumanoidRootPart
                            
                            -- สแกนหาผลไม้ใน Workspace ทั้งหมด
                            for _, v in pairs(workspace:GetChildren()) do
                                if not toggled then break end
                                
                                if v.Name:match("Fruit") or v:IsA("Tool") then
                                    local handle = v:FindFirstChild("Handle") or v.PrimaryPart or (v:IsA("BasePart") and v)
                                    if handle then
                                        pcall(function()
                                            -- 1. วาร์ปผลไม้มาแปะที่ตัวเราทันทีในเสี้ยววินาที (Instant)
                                            handle.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
                                            
                                            -- 2. สั่งยิงรีโมทเก็บเข้าคลังถาวรทันทีแบบรัวๆ
                                            replicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", v.Name, v)
                                        end)
                                    end
                                end
                            end

                            -- เช็คเผื่ออยู่ในโฟลเดอร์ Collectibles ของแมพ
                            local collectibles = workspace:FindFirstChild("Collectibles")
                            if collectibles then
                                for _, v in pairs(collectibles:GetChildren()) do
                                    if not toggled then break end
                                    local part = v:IsA("Model") and (v.PrimaryPart or v:FindFirstChildOfClass("BasePart")) or (v:IsA("BasePart") and v)
                                    if part then
                                        pcall(function()
                                            part.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
                                            replicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", v.Name, v)
                                        end)
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        else
            if pullConnection then
                task.cancel(pullConnection)
                pullConnection = nil
            end
        end
    end

    if toggled then
        runInstantPullTask(true)
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        SettingsData.PullFruit = toggled
        SaveConfig()

        if toggled then
            btn.Text = "⚡ เทเลพอร์ตผลไม้เข้าตัวทันที [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
            runInstantPullTask(true)
        else
            btn.Text = "⚡ เทเลพอร์ตผลไม้เข้าตัวทันที [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            runInstantPullTask(false)
        end
    end)
end

-- 📌 คำสั่งเรียกใช้งานในหน้า "ผลไม้"
createInstantPullFruitToggle(pFruit)




