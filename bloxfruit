    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            btn.Text = "⚡ ดึงผล + สแปมรีโมทเจ้าของแรก [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)

            fruitConnection = task.spawn(function()
                local workspace = game:GetService("Workspace")
                local replicatedStorage = game:GetService("ReplicatedStorage")
                
                while toggled do
                    task.wait(0.2) -- หน่วงเวลาเล็กน้อยเพื่อไม่ให้มือถือค้าง
                    
                    pcall(function()
                        local character = localPlayer.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local hrp = character.HumanoidRootPart
                            
                            -- ค้นหาผลไม้ที่ตกอยู่ใน Workspace
                            for _, v in pairs(workspace:GetChildren()) do
                                if not toggled then break end
                                
                                if v.Name:match("Fruit") or v:IsA("Tool") then
                                    local targetPart = v:FindFirstChild("Handle") or v.PrimaryPart or (v:IsA("BasePart") and v)
                                    if targetPart then
                                        -- 1. วาร์ปไปชิดตำแหน่งผลไม้ทันที
                                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
                                        
                                        -- 2. สแปม TouchInterest เพื่อยืนยันการแตะเก็บเป็นคนแรก
                                        firetouchinterest(hrp, targetPart, 0)
                                        firetouchinterest(hrp, targetPart, 1)
                                        
                                        -- 3. สแปมรีโมทหลักของเกมเพื่อบังคับเบิกผลเข้ากระเป๋า (ป้องกันผลไม่เข้าตัว)
                                        pcall(function()
                                            replicatedStorage.Remotes.CommF_:InvokeServer("StoreFruit", v.Name, v)
                                        end)
                                        
                                        task.wait(0.1)
                                    end
                                end
                            end

                            -- เช็คโฟลเดอร์ Collectibles สำรอง
                            local collectibles = workspace:FindFirstChild("Collectibles")
                            if collectibles then
                                for _, v in pairs(collectibles:GetChildren()) do
                                    if not toggled then break end
                                    if v:IsA("BasePart") then
                                        hrp.CFrame = v.CFrame + Vector3.new(0, 2, 0)
                                        firetouchinterest(hrp, v, 0)
                                        firetouchinterest(hrp, v, 1)
                                        task.wait(0.1)
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        else
            btn.Text = "⚡ ดึงผล + สแปมรีโมทเจ้าของแรก [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            toggled = false
            
            if fruitConnection then
                task.cancel(fruitConnection)
            end
        end
    end)
end

