-- ✈️ ฟังก์ชันออโต้บินนิ่งๆ ความเร็ว 150 (พิกัดใหม่สมูทไม่กระชาก)
-- ==========================================
local function createBuyDarkStepToggle(targetPage)
    SettingsData.BuyDarkStep = SettingsData.BuyDarkStep or false
    local toggled = SettingsData.BuyDarkStep
    local activeConnection = nil

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = toggled and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "🦵 ออโต้บินไปซื้อขาดำ (ความเร็ว 150) [ " .. (toggled and "ON" or "OFF") .. " ]"
    btn.TextColor3 = toggled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function runDarkStepTask(state)
        if state then
            activeConnection = task.spawn(function()
                pcall(function()
                    local player = game:GetService("Players").LocalPlayer
                    local character = player.Character
                    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                    local hrp = character.HumanoidRootPart
                    local humanoid = character:FindFirstChildOfClass("Humanoid")

                    -- 📌 พิกัดใหม่ที่คุณต้องการ (สามารถปรับเปลี่ยนตัวเลข Vector3 ตรงนี้ได้ครับ)
                    local targetPosition = Vector3.new(103.85, 12.07, 1782.15) 

                    if humanoid then
                        humanoid.PlatformStand = true
                    end

                    -- สร้าง Attachment และ LinearVelocity เพื่อบังคับความเร็วคงที่ 150 แบบนิ่งสนิท
                    local attachment = Instance.new("Attachment", hrp)
                    local linearVelocity = Instance.new("LinearVelocity", hrp)
                    linearVelocity.Attachment0 = attachment
                    linearVelocity.MaxForce = math.huge
                    linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)

                    -- สร้าง BodyVelocity หรือปิดแรงโน้มถ่วงไม่ให้ร่วง
                    local bodyVelocity = Instance.new("BodyVelocity", hrp)
                    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyVelocity.Velocity = Vector3.new(0, 0, 0)

                    while toggled do
                        local currentPos = hrp.Position
                        local direction = (targetPosition - currentPos)
                        local distance = direction.Magnitude

                        if distance < 5 then
                            -- ไปถึงเป้าหมายแล้ว หยุดเคลื่อนที่
                            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
                            break
                        end

                        -- คำนวณความเร็วคงที่ 150 Studs/s พุ่งตรงเป๊ะแบบไม่กระชาก
                        local speed = 150
                        bodyVelocity.Velocity = direction.Unit * speed
                        
                        -- หันหน้าไปทางเป้าหมายแบบสมูท
                        hrp.CFrame = CFrame.new(currentPos, targetPosition)

                        task.wait()
                    end

                    --เคลียร์ระบบฟิสิกส์เมื่อถึงที่หมาย
                    if bodyVelocity then bodyVelocity:Destroy() end
                    if linearVelocity then linearVelocity:Destroy() end
                    if attachment then attachment:Destroy() end

                    if humanoid then
                        humanoid.PlatformStand = false
                    end

                    -- สั่งยิงรีโมทซื้อ "Dark Step" ทันทีเมื่อถึง
                    if toggled then
                        local replicatedStorage = game:GetService("ReplicatedStorage")
                        local commF = replicatedStorage:FindFirstChild("Remotes") and replicatedStorage.Remotes:FindFirstChild("CommF_")
                        
                        if commF then
                            commF:InvokeServer("BuyDarkStep")
                        end
                    end
                end)
            end)
        else
            if activeConnection then
                task.cancel(activeConnection)
                activeConnection = nil
            end
            pcall(function()
                local character = game:GetService("Players").LocalPlayer.Character
                if character then
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then humanoid.PlatformStand = false end
                    for _, v in ipairs(character:FindFirstChild("HumanoidRootPart"):GetChildren()) do
                        if v:IsA("BodyVelocity") or v:IsA("LinearVelocity") or v:IsA("Attachment") then
                            v:Destroy()
                        end
                    end
                end
            end)
        end
    end

    if toggled then
        runDarkStepTask(true)
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        SettingsData.BuyDarkStep = toggled
        if SaveConfig then SaveConfig() end

        if toggled then
            btn.Text = "🦵 ออโต้บินไปซื้อขาดำ (ความเร็ว 150) [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
            runDarkStepTask(true)
        else
            btn.Text = "🦵 ออโต้บินไปซื้อขาดำ (ความเร็ว 150) [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            runDarkStepTask(false)
        end
    end)
end

createBuyDarkStepToggle(pShop)





