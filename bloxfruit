-- 👥 ฟังก์ชันระบบ ESP ผู้เล่น (มารีน = สีฟ้า, โจร = กรอบเขียว/ใสในสีส้ม)
-- ==========================================

local function createPlayerEspToggle(targetPage)
    local toggled = false
    local espConnection = nil
    local activeHighlights = {}

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "👥 ESP ผู้เล่นทั้งหมด [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function removeAllHighlights()
        for _, highlight in pairs(activeHighlights) do
            if highlight then
                highlight:Destroy()
            end
        end
        activeHighlights = {}
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            btn.Text = "👥 ESP ผู้เล่นทั้งหมด [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)

            -- เริ่มทำงานระบบ ESP ผู้เล่นทั่วทั้งแมพ
            espConnection = task.spawn(function()
                while toggled do
                    task.wait(0.5)
                    pcall(function()
                        local players = game:GetService("Players")
                        local localPlayer = players.LocalPlayer

                        for _, player in pairs(players:GetPlayers()) do
                            if player ~= localPlayer and player.Character then
                                local character = player.Character
                                local humanoid = character:FindFirstChild("Humanoid")

                                if humanoid and humanoid.Health > 0 then
                                    local team = player.Team
                                    local teamName = team and team.Name or ""
                                    
                                    -- กำหนดสีตามเงื่อนไขใหม่
                                    local fillColor, outlineColor
                                    
                                    if teamName == "Marine" then
                                        -- มารีน = สีฟ้าทั้งหมด
                                        fillColor = Color3.fromRGB(0, 170, 255)
                                        outlineColor = Color3.fromRGB(0, 170, 255)
                                    else
                                        -- โจรสรัด / อื่นๆ = ด้านในสีส้ม, กรอบเส้นสีเขียว
                                        fillColor = Color3.fromRGB(255, 128, 0)
                                        outlineColor = Color3.fromRGB(0, 255, 0)
                                    end

                                    -- สร้างหรืออัปเดต Highlight กรอบเรืองแสง
                                    local highlight = character:FindFirstChild("PlayerHighlight")
                                    if not highlight then
                                        highlight = Instance.new("Highlight")
                                        highlight.Name = "PlayerHighlight"
                                        highlight.Adornee = character
                                        highlight.Parent = character
                                        table.insert(activeHighlights, highlight)
                                    end

                                    -- อัปเดตสีตามที่ตั้งค่าไว้
                                    highlight.FillColor = fillColor
                                    highlight.FillTransparency = 0.75 -- ความจางด้านใน
                                    highlight.OutlineColor = outlineColor
                                    highlight.OutlineTransparency = 0  -- กรอบชัดเจน
                                end
                            end
                        end
                    end)
                end
            end)
        else
            btn.Text = "👥 ESP ผู้เล่นทั้งหมด [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            toggled = false

            if espConnection then
                task.cancel(espConnection)
            end
            removeAllHighlights()
        end
    end)
end

