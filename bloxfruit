-- ==========================================
-- 🌫️ ฟังก์ชันลบหมอก + ล็อกเวลาสว่างถาวร (แก้ปัญหาโดนดีดกลับ)
-- ==========================================
local function createRemoveFogToggle(targetPage)
    SettingsData.RemoveFog = SettingsData.RemoveFog or false
    local toggled = SettingsData.RemoveFog
    local lighting = game:GetService("Lighting")
    local runService = game:GetService("RunService")
    local lockConnection = nil

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = toggled and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "🌫️ ลบหมอก / ทะเลสว่าง [ " .. (toggled and "ON" or "OFF") .. " ]"
    btn.TextColor3 = toggled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function applyRemoveFog(state)
        if state then
            -- เริ่มต้นระบบล็อกเวลาและเคลียร์หมอกแบบเรียลไทม์ทุกเฟรม
            lockConnection = runService.Heartbeat:Connect(function()
                pcall(function()
                    lighting.Brightness = 2
                    lighting.ClockTime = 14 -- ล็อกเวลาไว้ที่บ่ายสอง (แดดจ้าสุดๆ)
                    lighting.FogEnd = 100000 -- ดันระยะหมอกออกไปไกล
                    lighting.GlobalShadows = false -- ปิดเงา
                    lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)

                    -- ซ่อน Atmosphere ดักไว้ไม่ให้เกมเปิดหมอกกลับมา
                    for _, v in ipairs(lighting:GetChildren()) do
                        if v:IsA("Atmosphere") then
                            v.Parent = nil
                        end
                    end
                end)
            end)
        else
            -- ปิดการทำงานและยกเลิกลูป
            if lockConnection then
                lockConnection:Disconnect()
                lockConnection = nil
            end
            pcall(function()
                lighting.Brightness = 1
                lighting.ClockTime = 12
                lighting.FogEnd = 10000
                lighting.GlobalShadows = true
            end)
        end
    end

    if toggled then
        applyRemoveFog(true)
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        SettingsData.RemoveFog = toggled
        if SaveConfig then SaveConfig() end

        if toggled then
            btn.Text = "🌫️ ลบหมอก / ทะเลสว่าง [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
            applyRemoveFog(true)
        else
            btn.Text = "🌫️ ลบหมอก / ทะเลสว่าง [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            applyRemoveFog(false)
        end
    end)
end

createRemoveFogToggle(pSeaEvent)
