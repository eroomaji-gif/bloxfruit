-- ⚡ ฟังก์ชันวาร์ปหมัดสายฟ้า (บินนุ่มๆ สมูทๆ ไม่กระชาก)
-- ==========================================
local function createElectroTeleportToggle(targetPage)
    local toggled = SettingsData.ElectroTeleport
    local tweenObject = nil

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = toggled and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "⚡ หมัดสายฟ้า [ " .. (toggled and "ON" or "OFF") .. " ]"
    btn.TextColor3 = toggled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local targetPosition = Vector3.new(-10372.78, 331.97, -10129.82)

    local function stopTween()
        if tweenObject then
            tweenObject:Cancel()
            tweenObject = nil
        end
    end

    local function runSmoothTween(state)
        if state then
            pcall(function()
                local character = localPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local humanoid = character:FindFirstChild("Humanoid")

                    if humanoid then
                        humanoid.PlatformStand = true
                    end

                    local distance = (hrp.Position - targetPosition).Magnitude
                    local speed = 160 -- ปรับความเร็วลงให้นุ่มนวล ไม่กระชาก
                    local timeTaken = distance / speed

                    local TweenService = game:GetService("TweenService")
                    -- เปลี่ยน EasingStyle เป็น Quad เพื่อความสมูท นุ่มนวลตอนออกตัวและหยุด
                    local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    
                    tweenObject = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPosition)})
                    tweenObject:Play()

                    tweenObject.Completed:Connect(function(status)
                        if status == Enum.PlaybackState.Completed and humanoid then
                            humanoid.PlatformStand = false
                            toggled = false
                            SettingsData.ElectroTeleport = false
                            SaveConfig()
                            btn.Text = "⚡ หมัดสายฟ้า [ OFF ]"
                            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
                            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                        end
                    end)
                end
            end)
        else
            stopTween()
            pcall(function()
                local character = localPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    character.Humanoid.PlatformStand = false
                end
            end)
        end
    end

    if toggled then
        runSmoothTween(true)
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        SettingsData.ElectroTeleport = toggled
        SaveConfig()

        if toggled then
            btn.Text = "⚡ หมัดสายฟ้า [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
            runSmoothTween(true)
        else
            btn.Text = "⚡ หมัดสายฟ้า [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            runSmoothTween(false)
        end
    end)
end

createElectroTeleportToggle(pShop)







