-- ⚔️ ระบบ Fast Attack (โจมตีออร่ารอบตัว ไม่แสดงอนิเมชั่น เลือดลดรัวๆ)
-- ==========================================
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- เพิ่มค่าสถานะลงใน SettingsData สำหรับบันทึก Config
SettingsData = SettingsData or {}
SettingsData.FastAttack = SettingsData.FastAttack or false

local fastAttackConnection = nil

local function runFastAttackSystem(state)
    if state then
        -- เริ่มต้นทำงานระบบสแปมดาเมจ
        fastAttackConnection = RunService.Heartbeat:Connect(function()
            pcall(function()
                local character = localPlayer.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                local hrp = character.HumanoidRootPart

                -- ค้นหาโฟลเดอร์มอนสเตอร์ในแมพ (Blox Fruits มักจะเก็บไว้ใน Workspace.Enemies)
                local enemiesFolder = workspace:FindFirstChild("Enemies")
                if not enemiesFolder then return end

                -- วนลูปเชื้อมอนสเตอร์ทุกตัวในรัศมีรอบตัวเรา (เช่น รัศมี 50 บล็อก)
                for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                    local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")
                    local humanoid = enemy:FindFirstChildOfClass("Humanoid")

                    if enemyHrp and humanoid and humanoid.Health > 0 then
                        local distance = (hrp.Position - enemyHrp.Position).Magnitude
                        
                        -- ถ้ามอนสเตอร์เข้ามาอยู่ในระยะรอบตัว (เช่น 55 บล็อก)
                        if distance <= 55 then
                            -- แอบดึงรีโมทโจมตีของเกมมายิงคำสั่งดาเมจใส่แบบไร้เสียง/ไร้อニメชั่น
                            local replicatedStorage = game:GetService("ReplicatedStorage")
                            local remotes = replicatedStorage:FindFirstChild("Remotes")
                            
                            if remotes then
                                local attackRemote = remotes:FindFirstChild("Validator") or remotes:FindFirstChild("CommF_")
                                
                                -- สั่งยิงดาเมจสแปมรัวๆ ไปที่มอนสเตอร์ตัวนั้น
                                pcall(function()
                                    -- ยิงรีโมทโจมตีจำลองเสมือนว่าเรากำลังฟันโดนมัน
                                    -- (ชื่อรีโมทดาเมจหลักของเกมจะถูกเรียกใช้งานตรงจุดนี้)
                                    if remotes:FindFirstChild("Net") then
                                        -- สำหรับรันไทม์ยุคใหม่ที่ใช้ระบบ Net Remote
                                        remotes.Net:FireServer("AttackAction", enemy)
                                    end
                                end)

                                -- ลดเลือดมอนสเตอร์ทางฝั่งพรีเซนต์ (หรือบังคับส่งดาเมจเคลียร์)
                                humanoid.Health = humanoid.Health - (humanoid.MaxHealth * 0.1) -- ช่วยเร่งดาเมจให้ตายไวขึ้น
                            end
                        end
                    end
                end
            end)
        end)
    else
        -- ถ้าปิดสวิตช์ ให้ตัดการทำงานทันที
        if fastAttackConnection then
            fastAttackConnection:Disconnect()
            fastAttackConnection = nil
        end
    end
end

