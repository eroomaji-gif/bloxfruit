-- 👁️ ฟังก์ชันระบบ ESP มอนสเตอร์ (รัศมี 200 เมตร พร้อมกรอบแดงและสีจาง)
-- ==========================================

local function createMonsterEspToggle(targetPage)
    local toggled = false
    local espConnection = nil
    local activeHighlights = {}

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "👁️ ESP มอนสเตอร์รอบตัว (200m) [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local function removeAllHighlights()
        for _, highlight in pairs(activeHighlights) do
            if highlight then
                highlight:Destroy()
            end
        end
        activeHighlights = {}
    end

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            btn.Text = "👁️ ESP มอนสเตอร์รอบตัว (200m) [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)

            -- เริ่มทำงานระบบ ESP เช็ครัศมี 200 เมตร
            espConnection = task.spawn(function()
                while toggled do
                    task.wait(0.5) -- เช็คทุกๆ 0.5 วินาทีเพื่อให้เรดาร์อัปเดตไวขึ้น
                    pcall(function()
                        local workspace = game:GetService("Workspace")
                        local players = game:GetService("Players")
                        local localPlayer = players.LocalPlayer
                        local character = localPlayer.Character
                        
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local hrp = character.HumanoidRootPart
                            local enemiesFolder = workspace:FindFirstChild("Enemies")
                            
                            if enemiesFolder then
                                -- ตรวจสอบมอนสเตอร์ทั้งหมดในแมพ
                                for _, enemy in pairs(enemiesFolder:GetChildren()) do
                                    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
                                    local humanoid = enemy:FindFirstChild("Humanoid")
                                    
                                    if enemyRoot and humanoid and humanoid.Health > 0 then
                                        -- คำนวณระยะห่างจากตัวผู้เล่น (หน่วยเป็น Studs / 1 เมตรโดยประมาณเท่ากับ 3-4 Studs แต่ตั้งไว้ที่ 600 Studs เทียบเท่าระยะ 200 เมตร)
                                        local distance = (enemyRoot.Position - hrp.Position).Magnitude
                                        
                                        if distance <= 600 then -- 600 Studs = ประมาณ 200 เมตร
                                            if not enemy:FindFirstChild("MonsterHighlight") then
                                                local highlight = Instance.new("Highlight")
                                                highlight.Name = "MonsterHighlight"
                                                highlight.Adornee = enemy
                                                highlight.Parent = enemy
                                                
                                                -- ตั้งค่ากรอบสีแดงและสีจางด้านใน
                                                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                                                highlight.FillTransparency = 0.75 -- ความจางด้านใน
                                                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
                                                highlight.OutlineTransparency = 0
                                                
                                                table.insert(activeHighlights, highlight)
                                            end
                                        else
                                            -- ถ้าเดินออกนอกระยะ 200 เมตร ให้เอาไฮไลท์ออกเพื่อประหยัดทรัพยากร
                                            local existingHighlight = enemy:FindFirstChild("MonsterHighlight")
                                            if existingHighlight then
                                                existingHighlight:Destroy()
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        else
            btn.Text = "👁️ ESP มอนสเตอร์รอบตัว (200m) [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            toggled = false
            
            if espConnection then
                task.cancel(espConnection)
            end
            removeAllHighlights()
        end
    end)
end

