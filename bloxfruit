local function createAutoCollectToggle(targetPage)
    local toggled = false

    local btn = Instance.new("TextButton")
    btn.Parent = targetPage
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.Font = Enum.Font.GothamBold
    btn.Text = "🧺 ออโต้เก็บผลเข้ากระเป๋า [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 13

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            btn.Text = "🧺 ออโต้เก็บผลเข้ากระเป๋า [ ON ]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
            btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)

            -- ระบบวาร์ปไปเก็บผลไม้ที่ดรอป
            task.spawn(function()
                while toggled do
                    task.wait(1)
                    pcall(function()
                        local workspace = game:GetService("Workspace")
                        local character = localPlayer.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local hrp = character.HumanoidRootPart
                            
                            -- วนหาผลไม้ที่ดรอปอยู่ในแมพ (มักจะเก็บไว้ในโฟลเดอร์ Collectibles หรือ Drop)
                            for _, v in pairs(workspace:GetChildren()) do
                                if v.Name == "Fruit" or v:IsA("Tool") or (v:FindFirstChild("Handle") and v.Name:match("Fruit")) then
                                    local targetPart = v:FindFirstChild("Handle") or v.PrimaryPart or v
                                    if targetPart and targetPart:IsA("BasePart") then
                                        -- วาร์ปตัวละครไปหาผลไม้ทันทีเพื่อให้เกมเก็เข้าตัว
                                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                    end
                                end
                            end
                            
                            -- เช็คในโฟลเดอร์ Collectibles สำรองด้วย
                            local collectibles = workspace:FindFirstChild("Collectibles")
                            if collectibles then
                                for _, v in pairs(collectibles:GetChildren()) do
                                    if v:IsA("BasePart") then
                                        hrp.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        else
            btn.Text = "🧺 ออโต้เก็บผลเข้ากระเป๋า [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            toggled = false
        end
    end)
end

